# --- Banco de dados ---
DATABASE_URL=postgres://estoque:estoque@localhost:5432/estoque
# DATABASE_SSL=true
# PG_POOL_MAX=10

# --- JWT (use um segredo aleatório com 32+ caracteres) ---
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-de-32-caracteres-ou-mais
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7
BCRYPT_ROUNDS=12

# --- HTTP ---
PORT=3000
CORS_ORIGINS=http://localhost:5173
# Atrás de proxy/load balancer: número de proxies (ex.: 1) para o rate limit enxergar o IP real
TRUST_PROXY=false

# --- Rate limiting (janela de 60 s, por IP) ---
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_AUTH=10

LOG_REQUESTS=true
